// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// AUTHENTICATION & USER MANAGEMENT MODELS
// ==========================================

enum RoleType {
  ADMIN
  WRITER
  HR_EDITOR
  MEMBER
  POST_EDITOR
  AUTHOR
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  fullName  String?
  password  String     @default("")
  image     String?
  role      RoleType   @default(MEMBER)
  roles     RoleType[] @default([MEMBER])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt @default(now())

  articles Article[]

  @@map("users")
}

// ==========================================
// MEMBER & HR DIRECTORY MODELS
// ==========================================

enum MemberStatus {
  ACTIVE
  INACTIVE
  ALUMNI
}

model Member {
  id             String        @id @default(uuid())
  fullName       String
  title          String?
  departmentName String?
  bio            String?
  profileImage   String?
  avatarUrl      String?
  volunteerHours Int           @default(0)
  status         MemberStatus  @default(ACTIVE)
  leadershipTier String        @default("Regular")
  joinDate       DateTime      @default(now())
  customSections Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt @default(now())

  certificates Certificate[]
  projectRoles ProjectRole[]

  @@map("members")
}

model Certificate {
  id              String   @id @default(uuid())
  certificateCode String   @unique
  title           String
  description     String
  issuedAt        DateTime @default(now())
  memberId        String
  member          Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt @default(now())

  @@map("certificates")
}

// ==========================================
// EDITORIAL BOARD MODELS
// ==========================================

model EditorialMember {
  id           String   @id @default(uuid())
  fullName     String
  academicRank String?
  university   String?
  specialty    String?
  bio          String?
  avatarUrl    String?
  orcidUrl     String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt @default(now())

  @@map("editorial_members")
}

// ==========================================
// ARTICLE EDITOR & JOURNAL PUBLISHING MODELS
// ==========================================

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ArticleType {
  BLOG
  ACADEMIC
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt @default(now())
  articles    Article[]

  @@map("categories")
}

model Article {
  id          String         @id @default(uuid())
  title       String
  slug        String         @unique
  excerpt     String?        @db.Text
  content     String         @db.Text
  coverImage  String?        @db.Text
  sources     String[]       @default([])
  status      ArticleStatus  @default(DRAFT)
  type        ArticleType    @default(BLOG)
  viewCount   Int            @default(0)
  publishedAt DateTime?
  authorId    String?
  author      User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  categoryId  String?
  category    Category?      @relation(fields: [categoryId], references: [id])
  authors     ArticleAuthors[]
  partners    PartnerArticle[]
  projects    ProjectArticle[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt @default(now())

  @@map("articles")
}

model ArticleAuthors {
  id        String   @id @default(uuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  name      String
  role      String?  @default("مؤلف مشارك")
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("article_authors")
}

// ==========================================
// PARTNERS & CO-AUTHORSHIP MODELS
// ==========================================

model Partner {
  id          String           @id @default(uuid())
  name        String
  slug        String           @unique
  description String?          @db.Text
  bio         String?          @db.Text
  logoUrl     String
  websiteUrl  String?
  order       Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt @default(now())

  articles    PartnerArticle[]
  projects    PartnerProject[]

  @@map("partners")
}

model PartnerArticle {
  id        String   @id @default(uuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([partnerId, articleId])
  @@map("partner_articles")
}

model PartnerProject {
  id        String   @id @default(uuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([partnerId, projectId])
  @@map("partner_projects")
}

// ==========================================
// PROJECTS & RESEARCH ECOSYSTEM MODELS
// ==========================================

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

model Project {
  id          String           @id @default(uuid())
  title       String
  slug        String           @unique
  description String?          @db.Text
  coverImage  String?          @db.Text
  status      ProjectStatus    @default(PLANNED)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt @default(now())

  members     ProjectRole[]
  articles    ProjectArticle[]
  partners    PartnerProject[]

  @@map("projects")
}

model ProjectRole {
  id        String   @id @default(uuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roleName  String   @default("باحث")
  createdAt DateTime @default(now())

  @@unique([memberId, projectId])
  @@map("project_roles")
}

model ProjectArticle {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, articleId])
  @@map("project_articles")
}

// ==========================================
// DYNAMIC HOMEPAGE & CMS MODELS
// ==========================================

model SiteSetting {
  id             String   @id @default("default")
  primaryColor   String   @default("#E84A0C")
  secondaryColor String   @default("#1A2B4A")
  pageHeaders    Json?
  homeBlocks     Json?
  academicSpecs  Json?
  updatedAt      DateTime @updatedAt @default(now())

  @@map("site_settings")
}

model JoinRequest {
  id              String   @id @default(uuid())
  nameAr          String
  nameEn          String
  contactInfo     String
  department      String
  education       String
  experience      String
  aboutPrometheus String
  reasonToJoin    String
  portfolioLink   String?
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt @default(now())

  @@map("join_requests")
}

model Department {
  id        String   @id @default(uuid())
  nameAr    String
  nameEn    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@map("departments")
}

// ==========================================
// ACTIVITIES & ATTENDANCE MANAGEMENT MODELS
// ==========================================

enum ActivityType {
  COURSE
  WORKSHOP
  LECTURE
  BOOTCAMP
  SEMINAR
}

enum ActivityStatus {
  UPCOMING
  ONGOING
  COMPLETED
  ARCHIVED
}

enum SessionFormStatus {
  OPEN
  CLOSED
}

model Activity {
  id            String            @id @default(uuid())
  title         String
  slug          String            @unique
  description   String?
  coverImage    String?
  type          ActivityType      @default(COURSE)
  totalSessions Int               @default(1)
  status        ActivityStatus    @default(UPCOMING)
  location      String?
  startDate     DateTime?
  endDate       DateTime?
  sessions      ActivitySession[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt @default(now())

  @@map("activities")
}

model ActivitySession {
  id                String             @id @default(uuid())
  activityId        String
  activity          Activity           @relation(fields: [activityId], references: [id], onDelete: Cascade)
  sessionNumber     Int
  title             String
  description       String?
  formStatus        SessionFormStatus  @default(CLOSED)
  expiresAt         DateTime?
  attendanceRecords AttendanceRecord[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt @default(now())

  @@unique([activityId, sessionNumber])
  @@map("activity_sessions")
}

model Participant {
  id                String             @id @default(uuid())
  nameAr            String
  nameEn            String
  email             String             @unique
  uniqueCode        String             @unique
  attendanceRecords AttendanceRecord[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt @default(now())

  @@map("participants")
}

model AttendanceRecord {
  id            String          @id @default(uuid())
  participantId String
  participant   Participant     @relation(fields: [participantId], references: [id], onDelete: Cascade)
  sessionId     String
  session       ActivitySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  feedback      String?
  createdAt     DateTime        @default(now())

  @@unique([participantId, sessionId])
  @@map("attendance_records")
}